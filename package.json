{
  "name": "yaparena",
  "version": "1.0.0",
  "description": "Backend foundation for a live debate platform",
  "scripts": {
    "build": "npm run typecheck && tsc --project tsconfig.json && npm run build:frontend",
    "build:frontend": "node scripts/build-frontend.ts",
    "watch:frontend": "node scripts/build-frontend.ts --watch",
    "typecheck": "npm run typecheck:operations && npm run typecheck:frontend",
    "typecheck:frontend": "node scripts/build-frontend.ts --check-sources && tsc --project tsconfig.frontend.json && tsc --project tsconfig.frontend-auth.json && tsc --project tsconfig.service-worker.json && tsc --project tsconfig.frontend-build.json",
    "test": "npm run build && node --test tests/*.test.js",
    "test:revocation": "npm run build && node --test tests/session-revocation-postgres.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=scripts/** --test-coverage-exclude=tests/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:replay-worker": "node dist/replay-worker.js",
    "dev": "node scripts/build-frontend.ts --dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm run check:files && npm run typecheck && npm run test:coverage",
    "format:check": "prettier --check .",
    "check:files": "node scripts/check-repository-files.ts",
    "migrate": "node scripts/migrate-database.ts",
    "research:a4": "npm run build && node scripts/a4-research.js",
    "verify:a4": "npm run build && A4_VERIFY=true node scripts/verify-database-isolation.ts",
    "verify:browser": "node scripts/verify-browser-release.ts",
    "verify:database-isolation": "npm run build && node scripts/verify-database-isolation.ts",
    "inventory:database": "node scripts/inventory-database.ts",
    "seed:discovery": "node --env-file-if-exists=.env scripts/seed-discovery.ts",
    "initialize": "node scripts/initialize-project.js",
    "verify:community-delivery": "npm run build && COMMUNITY_DURABLE_TRIAL=1 node scripts/verify-community-local.ts",
    "verify:media-packaging": "node scripts/verify-media-packaging.ts",
    "verify:replay-pipeline": "npm run build && node scripts/verify-replay-pipeline.ts",
    "report:playback": "node scripts/report-playback.js",
    "typecheck:operations": "tsc --project tsconfig.json --emitDeclarationOnly && tsc --project tsconfig.database-tools.json && tsc --project tsconfig.browser-automation.json && tsc --project tsconfig.community-tools.json && tsc --project tsconfig.replay-tools.json && tsc --project tsconfig.edge.json",
    "verify:community-native-setup": "npm run build && LC_ALL=C LANG=C COMMUNITY_POSTGRES_MODE=host node scripts/verify-community-local.ts --setup-only",
    "verify:auth-redis": "node scripts/verify-auth-redis.ts",
    "verify:email-auth-browser": "node scripts/verify-email-auth-browser.ts",
    "reset:test-accounts": "node scripts/reset-test-accounts.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "@reown/appkit@1.8.9": false,
    "bufferutil@4.1.0": false,
    "keccak@3.0.4": false,
    "utf-8-validate@5.0.10": false
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "@privy-io/node": "0.36.0",
    "@privy-io/react-auth": "3.50.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@solana-program/memo": "0.10.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.8.0",
    "@solana/kit": "5.1.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hls.js": "1.7.3",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "node-pg-migrate": "^9.0.0",
    "ox": "0.8.9",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "^7.2.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "ws": "8.22.0",
    "decode-uri-component": "0.5.0"
  }
}
