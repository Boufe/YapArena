{
  "name": "yaparena",
  "version": "1.0.0",
  "description": "Backend foundation for a live debate platform",
  "scripts": {
    "build": "tsc --project tsconfig.json && esbuild public/media-entry.js --bundle --minify --format=iife --outfile=public/media.bundle.js && esbuild public/replay-entry.js --bundle --minify --format=iife --outfile=public/replay.bundle.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "test:revocation": "npm run build && node --test tests/session-revocation-postgres.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-exclude=scripts/** --test-coverage-exclude=tests/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 tests/*.test.js",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:replay-worker": "node dist/replay-worker.js",
    "dev": "node --env-file-if-exists=.env.runtime --watch src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "format:check": "prettier --check .",
    "migrate": "node scripts/migrate-database.js",
    "verify:database-isolation": "npm run build && node scripts/verify-database-isolation.js",
    "inventory:database": "node scripts/inventory-database.js",
    "seed:discovery": "node --env-file-if-exists=.env scripts/seed-discovery.js",
    "initialize": "node scripts/initialize-project.js",
    "verify:community-delivery": "npm run build && COMMUNITY_DURABLE_TRIAL=1 node scripts/verify-community-local.js",
    "verify:media-packaging": "node scripts/verify-media-packaging.js",
    "verify:replay-pipeline": "npm run build && node scripts/verify-replay-pipeline.js",
    "report:playback": "node scripts/report-playback.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hls.js": "1.7.3",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
